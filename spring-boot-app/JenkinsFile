pipeline {
  agent {
    docker {
      image 'jibin321/maven-docker-agent:v2'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
    }
  }

//adding enviornment

 environment {
        DOCKER_IMAGE = "ayanshaji/springboot-app"
        GIT_REPO_NAME = "java-maven-sonar-argocd"
        GIT_USER_NAME = "ayanshaji"
}

  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        //git branch: 'main', url: 'https://github.com/user/repo.git'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'cd spring-boot-app && mvn clean package'
      }
    }

// edited sonarqube

   stage('SonarQube Analysis') {
    steps {
        dir('spring-boot-app') {
            withSonarQubeEnv('sonarqube') {
                sh '''
                    mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                      -Dsonar.projectKey=springboot-gitops-app \
                      -Dsonar.projectName="Springboot GitOps App"
                '''
            }
        }
    }
}

    stage('Build and Push Docker Image') {
      steps {
        script {
          sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} ./spring-boot-app' // edited location / path

          def dockerImage = docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")
          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            dockerImage.push()
            dockerImage.push("latest")
          }
        }
      }
    }

   stage('Update Deployment File') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'git-hub',
            usernameVariable: 'GITHUB_USERNAME',
            passwordVariable: 'GITHUB_TOKEN'
        )]) {
            sh '''
                git init
                git remote add origin https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git

                git config user.email "jojuambily103@gmail.com"
                git config user.name "${GIT_USER_NAME}"

                sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" spring-boot-app-manifests/deployment.yml

                git add spring-boot-app-manifests/deployment.yml
                git commit -m "Update springboot app image tag to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"

                git push origin HEAD:main
            '''
        }
    }
}

  post {
    always {
      cleanWs()
    }
  }
}
